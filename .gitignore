# ==========================================
# Manual_WMS - Git Ignore
# ==========================================

# ------------------------------
# .NET / ASP.NET
# ------------------------------
**/bin/
**/obj/

# Visual Studio
.vs/
**/.vs/

# User-specific Visual Studio files
*.user
*.suo

# ------------------------------
# Angular
# ------------------------------
node_modules/
**/node_modules/

.angular/cache/
**/.angular/cache/

# Angular build output
dist/
**/dist/
tmp/
out-tsc/

# ------------------------------
# VS Code
# ------------------------------
.vscode/

# ------------------------------
# IDEs
# ------------------------------
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.history/

# ------------------------------
# Logs
# ------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ------------------------------
# Test / Coverage
# ------------------------------
coverage/
test-results/

# ------------------------------
# OS files
# ------------------------------
.DS_Store
Thumbs.db

# ------------------------------
# Temporary files
# ------------------------------
*.tmp
*.temp
*.swp
*.swo

# ------------------------------
# Environment / secrets
# ------------------------------
.env
.env.*
!.env.example

# ------------------------------
# Miscellaneous
# ------------------------------
.sass-cache/
connect.lock
.typings/
__screenshots__/
